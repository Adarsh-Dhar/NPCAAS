# LLM
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Kite Agent Passport (x402 payment protocol)
KITE_API_BASE=https://api.gokite.ai
KITE_AGENT_ID=nexus-broker-default
KITE_SESSION_ID=session-default
KITE_FACILITATOR_URL=https://facilitator.pieverse.io
KITE_PAYEE_ADDRESS=0xYourServiceWalletAddress
KITE_ASSET_ADDRESS=0x0fF5393387ad2f9f691FD6Fd28e07E3969e27e63
KITE_NETWORK=kite-testnet
KITE_EXPLORER_API=https://testnet.kitescan.ai/api

# Nexus Server
NEXUS_SERVER_URL=http://localhost:5000
NEXUS_PUBLIC_URL=https://your-public-https-domain.example
NEXUS_CORS_ORIGIN=*
NEXUS_API_KEY=
NEXUS_LOG_LEVEL=info
NEXUS_MAX_PER_TX=50.00
NEXUS_MAX_TOTAL=500.00
NEXUS_SESSION_TTL=1h
NEXUS_ASSETS=USDC
NEXUS_PAYMENT=x402
NEXUS_HIDDEN_FLOOR=40
NEXUS_HIDDEN_CEILING=50
NEXUS_ROLE=buyer
# Kite Agent Passport - Production mode only (no mocks)
KPASS_BIN=kpass

# Server runtime
PORT=5000
DATASET_FILENAME=sentiment-dataset.csv

# Optional tuning
DELIVERY_TOKEN_TTL_MS=3600000
DELIVERY_TOKEN_CLEANUP_MS=60000
NEXUS_CONFIRM_MAX_ATTEMPTS=10
NEXUS_CONFIRM_DELAY_MS=3000
NEXUS_RETRY_POLL_MS=10000
